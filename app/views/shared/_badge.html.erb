<%
  variant_classes = {
    success: "bg-emerald-100 text-emerald-800",
    warning: "bg-amber-100 text-amber-800",
    danger: "bg-red-100 text-red-800",
    neutral: "bg-slate-100 text-slate-700",
  }
%>
<span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium <%= variant_classes.fetch(variant.to_sym, variant_classes[:neutral]) %>">
  <%= text %>
</span>
