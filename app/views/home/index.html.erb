<h1 class="mb-8 text-2xl font-bold text-slate-900"><%= t(".title") %></h1>

<section class="mb-8 rounded-xl border border-slate-200 bg-white p-6">
  <h2 class="mb-4 text-lg font-semibold text-slate-900">GitHub 專案匯入</h2>
  <%= form_with url: projects_path, method: :post, class: "flex flex-wrap items-end gap-4" do |form| %>
    <div>
      <%= label_tag "project[owner]", "Owner", class: "block text-sm font-medium text-slate-700" %>
      <%= text_field_tag "project[owner]", nil, placeholder: "AMASTek",
            class: "mt-1 rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500" %>
    </div>
    <div>
      <%= label_tag "project[repository_name]", "Repository", class: "block text-sm font-medium text-slate-700" %>
      <%= text_field_tag "project[repository_name]", nil, placeholder: "PrjJieZhou",
            class: "mt-1 rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500" %>
    </div>
    <details class="w-full">
      <summary class="cursor-pointer text-sm text-slate-500 hover:text-slate-700">Advanced Option</summary>
      <div class="mt-2">
        <%= label_tag "project[default_branch]", "母分支（留空則自動讀取 GitHub Default Branch）", class: "block text-sm font-medium text-slate-700" %>
        <%= text_field_tag "project[default_branch]", nil, placeholder: "main",
              class: "mt-1 rounded-lg border border-slate-300 px-3 py-2 text-sm focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500" %>
      </div>
    </details>
    <%= form.submit "開始匯入", class: "rounded-lg bg-blue-600 px-4 py-2 text-sm font-medium text-white hover:bg-blue-700" %>
  <% end %>
</section>

<section class="rounded-xl border border-slate-200 bg-white">
  <h2 class="border-b border-slate-200 px-6 py-4 text-lg font-semibold text-slate-900">已匯入專案</h2>
  <% if @projects.empty? %>
    <p class="px-6 py-8 text-sm text-slate-500">尚未匯入任何專案。</p>
  <% else %>
    <div class="overflow-x-auto">
      <table class="w-full text-left text-sm">
        <thead class="border-b border-slate-200 text-xs uppercase text-slate-500">
          <tr>
            <th class="w-8 px-6 py-3"></th>
            <th class="px-3 py-3">專案</th>
            <th class="px-3 py-3">母分支</th>
            <th class="px-3 py-3">Base SHA</th>
            <th class="px-3 py-3">功能數</th>
            <th class="px-3 py-3">狀態</th>
            <th class="px-3 py-3">最後同步</th>
            <th class="px-3 py-3">操作</th>
          </tr>
        </thead>
        <% @projects.each do |project| %>
          <%= render "home/project_row", project: project %>
        <% end %>
      </table>
    </div>
  <% end %>
</section>
