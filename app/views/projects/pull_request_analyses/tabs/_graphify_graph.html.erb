<section id="graphify" class="scroll-mt-4">
  <% artifact = @pull_request_analysis.graphify_artifacts.find_by(format: "graph_json") %>

  <% if artifact.blank? || artifact.parsed_content.blank? %>
    <h2 class="mb-3 text-lg font-semibold text-slate-900">Graphify 依賴圖</h2>
    <p class="text-sm text-slate-500">尚未取得（可能仍在分析中，或此階段尚未支援）。</p>
  <% else %>
    <% scope = Projects::PullRequestAnalysesController::GRAPH_SCOPES.include?(params[:scope]) ? params[:scope] : "pr"
       depth = params[:depth].presence&.to_i&.clamp(1, 3) || GraphifySubgraphBuilder::DEFAULT_DEPTH
       subgraph = GraphifySubgraphBuilder.call(pull_request_analysis: @pull_request_analysis, index: GraphifyGraphIndex.new(artifact.parsed_content), max_depth: depth)
       graph_src = graph_project_pull_request_analysis_path(@project, @pull_request_analysis, scope: scope, depth: depth) %>

    <div class="mb-3 flex flex-wrap items-center justify-between gap-3">
      <h2 class="text-lg font-semibold text-slate-900">Graphify 依賴圖</h2>
      <div class="flex flex-wrap items-center gap-3 text-sm">
        <%= form_with url: project_pull_request_analysis_path(@project, @pull_request_analysis, anchor: "graphify"), method: :get, class: "flex items-center gap-2" do %>
          <%= hidden_field_tag :tab, "impact" %>
          <%= label_tag :scope, "範圍", class: "text-slate-500" %>
          <%= select_tag :scope, options_for_select([ [ "PR 影響範圍", "pr" ], [ "整個專案", "project" ] ], scope),
                class: "rounded-lg border border-slate-300 px-2 py-1 focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500" %>
          <%= label_tag :depth, "Depth", class: "text-slate-500" %>
          <%= select_tag :depth, options_for_select([ 1, 2, 3 ].map { |d| [ d, d ] }, depth),
                class: "rounded-lg border border-slate-300 px-2 py-1 focus:border-blue-500 focus:outline-none focus:ring-2 focus:ring-blue-500" %>
          <%= submit_tag "套用", class: "rounded-lg border border-slate-300 px-3 py-1 font-medium text-slate-700 hover:bg-slate-100" %>
        <% end %>
        <%= link_to "在新分頁開啟 ↗", graph_src, target: "_blank", rel: "noopener", class: "text-slate-500 hover:text-blue-600" %>
      </div>
    </div>

    <% if scope == "pr" && subgraph[:node_ids].empty? %>
      <p class="text-sm text-slate-500">
        此 PR 的異動實體在 Graphify 依賴圖中找不到對應節點（可能是新增檔案，或不屬於 Graphify 支援的類型）。
        可改選「整個專案」檢視完整依賴圖。
      </p>
    <% else %>
      <div class="grid grid-cols-1 overflow-hidden rounded-xl border border-slate-200 bg-white lg:grid-cols-[1fr_300px]"
           data-controller="graphify-frame"
           data-graphify-frame-inspector-url-template-value="<%= project_pull_request_analysis_graphify_node_path(@project, @pull_request_analysis, "__NODE_ID__") %>">
        <iframe src="<%= graph_src %>" title="Graphify 依賴圖" data-graphify-frame-target="frame" loading="lazy"
                class="h-[75vh] min-h-[560px] w-full border-0 bg-[#0f0f1a]"></iframe>

        <div class="max-h-96 overflow-y-auto border-t border-slate-200 p-3 lg:max-h-[75vh] lg:border-l lg:border-t-0">
          <h3 class="mb-2 text-xs font-semibold uppercase text-slate-500">Inspector</h3>
          <turbo-frame id="graph-inspector" data-graphify-frame-target="inspector">
            <p class="text-sm text-slate-500">點擊圖中節點，可在此查看對應的業務功能與影響範圍。</p>
          </turbo-frame>
        </div>
      </div>

      <p class="mt-3 text-xs text-slate-500">
        <% if scope == "pr" %>
          顯示與此 PR 異動實體相距 <%= depth %> 層內的依賴節點，以及其所屬類別／檔案（<%= subgraph[:node_ids].size %> 個節點）。
        <% else %>
          顯示整個專案的 Graphify 依賴圖（<%= artifact.parsed_content.fetch("nodes", []).size %> 個節點）。
        <% end %>
        顏色為 Graphify 社群分群；紅框為 PR 異動節點，橘框為直接依賴。
      </p>
    <% end %>
  <% end %>

  <details class="mt-6">
    <summary class="cursor-pointer text-sm text-slate-500 hover:text-slate-700">Advanced：Raw Graphify JSON</summary>
    <% @pull_request_analysis.graphify_artifacts.each do |a| %>
      <p class="mt-2 text-xs text-slate-500"><%= a.format %>（<%= a.graphify_version %>，<%= a.generated_at %>）</p>
      <pre class="mt-1 max-h-96 overflow-auto rounded-md bg-slate-50 p-3 text-xs"><%= a.raw_content %></pre>
    <% end %>
  </details>
</section>
