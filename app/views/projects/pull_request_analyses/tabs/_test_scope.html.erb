<section>
  <% if @test_report.nil? %>
    <p class="text-sm text-slate-500">尚未取得（可能仍在分析中，或此階段尚未支援）。</p>
  <% else %>
    <% structured = @test_report.structured_content || {}
       cases = @test_report.test_cases.includes(:business_feature).order(:position).to_a
       cases_by_page = cases.group_by { |c| c.page_path.presence || "（未對應畫面）" } %>

    <div class="mb-6 rounded-xl border border-slate-200 bg-white p-6">
      <div class="flex flex-wrap items-start justify-between gap-4">
        <div>
          <h2 class="text-lg font-semibold text-slate-900"><%= @test_report.title %></h2>
          <p class="mt-1 text-xs text-slate-500">
            <%= @test_report.llm_provider %> / <%= @test_report.llm_model %> · Prompt <%= @test_report.prompt_version %>
            · <%= @test_report.created_at.strftime("%Y/%m/%d %H:%M") %>
          </p>
        </div>
        <div class="flex items-center gap-6 text-right text-sm">
          <div>
            <p class="text-xs uppercase text-slate-500">測試案例</p>
            <p class="text-lg font-semibold text-slate-900"><%= cases.size %></p>
          </div>
          <div>
            <p class="text-xs uppercase text-slate-500">涉及畫面</p>
            <p class="text-lg font-semibold text-slate-900"><%= cases_by_page.size %></p>
          </div>
          <div>
            <p class="text-xs uppercase text-slate-500">需人工確認</p>
            <p class="text-lg font-semibold text-slate-900"><%= Array(structured["uncertain_items"]).size %></p>
          </div>
          <div title="輸入 <%= number_with_delimiter(@test_report.input_tokens.to_i) %>（其中快取 <%= number_with_delimiter(@test_report.cached_input_tokens.to_i) %>）／輸出 <%= number_with_delimiter(@test_report.output_tokens.to_i) %> tokens">
            <p class="text-xs uppercase text-slate-500">本報告費用（估算）</p>
            <p class="text-lg font-semibold text-slate-900"><%= llm_cost_text(@test_report.estimated_cost_usd) %></p>
          </div>
          <% if @test_report.markdown_content.present? %>
            <%= link_to "下載報告（Markdown）", report_project_pull_request_analysis_path(@project, @pull_request_analysis),
                  class: "rounded-lg border border-slate-300 px-3 py-1.5 text-sm font-medium text-slate-700 hover:bg-slate-100" %>
          <% end %>
        </div>
      </div>

      <% changes = Array(structured.dig("summary", "changes")) %>
      <% if changes.any? %>
        <dl class="mt-4 grid gap-2 text-sm sm:grid-cols-[180px_1fr]">
          <% changes.each do |change| %>
            <dt class="font-medium text-slate-700"><%= change["type"] %></dt>
            <dd class="text-slate-600"><%= change["description"] %></dd>
          <% end %>
        </dl>
      <% elsif @test_report.summary.present? %>
        <div class="mt-4 text-sm text-slate-600"><%= simple_format(@test_report.summary) %></div>
      <% end %>
    </div>

    <% if Array(structured["preparation"]).any? %>
      <div class="mb-6 rounded-xl border border-slate-200 bg-white p-6">
        <h3 class="mb-2 font-semibold text-slate-900">測試前準備</h3>
        <ol class="list-decimal space-y-1 pl-5 text-sm text-slate-700">
          <% structured["preparation"].each do |item| %><li><%= item %></li><% end %>
        </ol>
      </div>
    <% end %>

    <h3 class="mb-3 font-semibold text-slate-900">依畫面分組的測試案例</h3>
    <% if cases.empty? %>
      <p class="mb-6 text-sm text-slate-500">此次分析未產生具體測試案例，詳見「需要人工確認」。</p>
    <% end %>
    <div class="mb-6 space-y-3">
      <% cases_by_page.each do |page_path, page_cases| %>
        <details class="rounded-xl border border-slate-200 bg-white" open>
          <summary class="flex cursor-pointer items-center justify-between gap-3 px-5 py-3 hover:bg-slate-50">
            <span class="font-medium text-slate-900"><%= page_path %></span>
            <span class="text-xs text-slate-500"><%= page_cases.size %> 個案例</span>
          </summary>
          <div class="divide-y divide-slate-100 border-t border-slate-200">
            <% page_cases.each do |test_case| %>
              <article class="px-5 py-4">
                <div class="flex flex-wrap items-center gap-2">
                  <span class="text-xs text-slate-400">#<%= test_case.position %></span>
                  <h4 class="font-medium text-slate-900"><%= test_case.name %></h4>
                  <%= case_type_badge(test_case.case_type, test_case.case_type_text) %>
                  <% if test_case.business_feature %><span class="text-xs text-slate-500">功能：<%= test_case.business_feature.name %></span><% end %>
                </div>
                <p class="mt-2 text-sm text-slate-600"><span class="font-medium text-slate-700">驗證內容：</span><%= test_case.verification_purpose %></p>
                <% if test_case.steps.present? %>
                  <ol class="mt-2 list-decimal space-y-0.5 pl-5 text-sm text-slate-700">
                    <% test_case.steps.each do |step| %><li><%= step %></li><% end %>
                  </ol>
                <% end %>
                <p class="mt-2 text-sm"><span class="font-medium text-emerald-700">預期結果：</span><span class="text-slate-700"><%= test_case.expected_result %></span></p>
                <% if test_case.failure_criteria.present? %>
                  <p class="mt-1 text-sm"><span class="font-medium text-red-700">失敗判讀：</span><span class="text-slate-700"><%= test_case.failure_criteria %></span></p>
                <% end %>
                <% if test_case.notes.present? %>
                  <p class="mt-1 text-sm text-slate-500">注意事項：<%= test_case.notes %></p>
                <% end %>
                <% if test_case.evidence.present? %>
                  <details class="mt-2">
                    <summary class="cursor-pointer text-xs text-slate-400 hover:text-slate-600">分析依據</summary>
                    <p class="mt-1 font-mono text-xs text-slate-500"><%= Array(test_case.evidence).join("、") %></p>
                  </details>
                <% end %>
              </article>
            <% end %>
          </div>
        </details>
      <% end %>
    </div>

    <% if Array(structured["pass_criteria"]).any? || Array(structured["manual_checks"]).any? %>
      <div class="mb-6 grid gap-4 lg:grid-cols-2">
        <% if Array(structured["pass_criteria"]).any? %>
          <div class="rounded-xl border border-slate-200 bg-white p-6">
            <h3 class="mb-2 font-semibold text-slate-900">測試通過標準</h3>
            <ul class="list-disc space-y-1 pl-5 text-sm text-slate-700">
              <% structured["pass_criteria"].each do |c| %><li><%= c %></li><% end %>
            </ul>
          </div>
        <% end %>
        <% if Array(structured["manual_checks"]).any? %>
          <div class="rounded-xl border border-slate-200 bg-white p-6">
            <h3 class="mb-2 font-semibold text-slate-900">建議人工額外檢查</h3>
            <ul class="list-disc space-y-1 pl-5 text-sm text-slate-700">
              <% structured["manual_checks"].each do |c| %><li><%= c %></li><% end %>
            </ul>
          </div>
        <% end %>
      </div>
    <% end %>

    <% if Array(structured["uncertain_items"]).any? %>
      <div class="mb-6 rounded-xl border border-amber-200 bg-amber-50 p-6">
        <h3 class="mb-1 font-semibold text-amber-900">需要人工確認</h3>
        <p class="mb-3 text-xs text-amber-800">無法寫成畫面操作步驟的異動，請工程或資訊人員協助確認。</p>
        <ul class="space-y-2 text-sm text-amber-900">
          <% structured["uncertain_items"].each do |item| %>
            <li>
              <span class="font-medium"><%= item["description"] %></span>
              <% if Array(item["refs"]).any? %><span class="font-mono text-xs text-amber-700">（<%= Array(item["refs"]).join("、") %>）</span><% end %>
              <% if item["reason"].present? %><span class="text-amber-800"> — <%= item["reason"] %></span><% end %>
            </li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <% if Array(structured["screen_map"]).any? %>
      <p class="mb-6 text-sm text-slate-500">
        每項異動對應到哪個畫面、系統如何判斷，請見
        <%= link_to "「影響範圍」分頁", project_pull_request_analysis_path(@project, @pull_request_analysis, tab: "impact", anchor: "screen-map"), class: "text-blue-600 hover:underline" %>。
      </p>
    <% end %>

    <% runs = @pull_request_analysis.test_reports.where(generated_by: "llm").order(created_at: :desc).to_a %>
    <details class="mb-6 rounded-xl border border-slate-200 bg-white">
      <summary class="cursor-pointer px-5 py-3 text-sm text-slate-600 hover:bg-slate-50">
        產生紀錄與 LLM 費用<span class="ml-2 text-xs text-slate-500">此 PR 共 <%= runs.size %> 次，合計 <%= llm_cost_text(total_llm_cost_usd(runs)) %>（估算）</span>
      </summary>
      <div class="overflow-x-auto border-t border-slate-200">
        <table class="w-full text-left text-sm">
          <thead class="border-b border-slate-200 text-xs uppercase text-slate-500">
            <tr>
              <th class="px-5 py-2">產生時間</th>
              <th class="px-3 py-2">狀態</th>
              <th class="px-3 py-2">模型</th>
              <th class="px-3 py-2 text-right">輸入 tokens（快取）</th>
              <th class="px-3 py-2 text-right">輸出 tokens</th>
              <th class="px-3 py-2 text-right">耗時</th>
              <th class="px-3 py-2 text-right">費用（估算）</th>
            </tr>
          </thead>
          <tbody class="divide-y divide-slate-100">
            <% runs.each do |run| %>
              <tr class="<%= 'bg-blue-50/40' if run == @test_report %>">
                <td class="px-5 py-2 text-slate-700"><%= run.created_at.strftime("%Y/%m/%d %H:%M") %><% if run == @test_report %><span class="ml-1 text-xs text-blue-600">（目前顯示）</span><% end %></td>
                <td class="px-3 py-2"><%= status_badge(run.status, run.status_text) %></td>
                <td class="px-3 py-2 font-mono text-xs text-slate-600"><%= run.llm_model %></td>
                <td class="px-3 py-2 text-right text-slate-700"><%= number_with_delimiter(run.input_tokens.to_i) %>（<%= run.cached_input_tokens.nil? ? "未記錄" : number_with_delimiter(run.cached_input_tokens) %>）</td>
                <td class="px-3 py-2 text-right text-slate-700"><%= number_with_delimiter(run.output_tokens.to_i) %></td>
                <td class="px-3 py-2 text-right text-slate-500"><%= run.duration_ms ? "#{(run.duration_ms / 1000.0).round} 秒" : "—" %></td>
                <td class="px-3 py-2 text-right font-medium text-slate-900"><%= llm_cost_text(run.estimated_cost_usd, rate: run.pricing&.dig("usd_twd_rate") || Llm::Pricing.usd_to_twd_rate) %></td>
              </tr>
            <% end %>
          </tbody>
        </table>
        <p class="px-5 py-3 text-xs text-slate-500">
          費用＝各次呼叫的 token 數 × 單價（<%= Llm::Pricing::USD_PER_MILLION_TOKENS.map { |m, p| "#{m}：輸入 US$#{format('%.2f', p[:input])}／快取輸入 US$#{format('%.2f', p[:cached_input])}／輸出 US$#{format('%.2f', p[:output])}（每百萬 tokens）" }.join("；") %>），
          僅供參考，實際金額以供應商帳單為準。
          <% unless Llm::Pricing.usd_to_twd_rate %>尚未設定美元兌新台幣匯率（LLM_USD_TWD_RATE），因此以美元顯示。<% end %>
        </p>
      </div>
    </details>

    <% if @test_report.markdown_content.present? %>
      <details class="rounded-xl border border-slate-200 bg-white">
        <summary class="cursor-pointer px-5 py-3 text-sm text-slate-500 hover:bg-slate-50">完整測試範圍報告（Markdown 原文）</summary>
        <pre class="max-h-[60vh] overflow-auto border-t border-slate-200 p-5 text-xs text-slate-700"><%= @test_report.markdown_content %></pre>
      </details>
    <% end %>
  <% end %>
</section>
