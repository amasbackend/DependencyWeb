<section>
  <% files = @pull_request_analysis.changed_files.order(:file_path).to_a %>
  <% if files.empty? %>
    <p class="text-sm text-slate-500">尚未取得（可能仍在分析中）。</p>
  <% else %>
    <% entities_by_file = @pull_request_analysis.changed_code_entities.order(:id).group_by(&:changed_file_id)
       files_by_group = files.group_by { |f| changed_file_group(f.file_path) } %>

    <div class="mb-6 flex flex-wrap items-center gap-x-6 gap-y-2 rounded-xl border border-slate-200 bg-white px-6 py-4 text-sm">
      <span class="font-medium text-slate-900"><%= files.size %> 個檔案</span>
      <span>
        <span class="text-emerald-600">+<%= files.sum { |f| f.additions.to_i } %></span>
        <span class="text-red-600">-<%= files.sum { |f| f.deletions.to_i } %></span>
      </span>
      <% files.group_by(&:change_type).each do |change_type, group| %>
        <span class="text-slate-600"><%= group.first.change_type_text %> <%= group.size %></span>
      <% end %>
      <span class="text-slate-600">異動類別／方法 <%= entities_by_file.values.sum(&:size) %></span>
      <span class="ml-auto flex flex-wrap gap-2">
        <% changed_file_groups_order.each do |group| %>
          <% next unless files_by_group[group] %>
          <a href="#files-<%= changed_file_groups_order.index(group) %>"
             class="rounded-md border border-slate-200 px-2 py-1 text-xs text-slate-600 hover:bg-slate-100"><%= group %> <%= files_by_group[group].size %></a>
        <% end %>
      </span>
    </div>

    <% changed_file_groups_order.each do |group| %>
      <% next unless files_by_group[group] %>
      <h3 id="files-<%= changed_file_groups_order.index(group) %>" class="mb-2 mt-6 scroll-mt-4 font-semibold text-slate-900">
        <%= group %> <span class="text-sm font-normal text-slate-500"><%= files_by_group[group].size %> 個檔案</span>
      </h3>
      <div class="rounded-xl border border-slate-200 bg-white">
        <% files_by_group[group].each do |file| %>
          <%= render "projects/pull_request_analyses/tabs/diff_file", file: file, entities: entities_by_file.fetch(file.id, []) %>
        <% end %>
      </div>
    <% end %>
  <% end %>
</section>
