<h1>PR #<%= @pull_request_analysis.pr_number %></h1>
<p><%= link_to "← 返回專案", project_path(@project) %></p>

<section>
  <h2>狀態</h2>
  <p><%= @pull_request_analysis.status_text %></p>
  <% if @pull_request_analysis.status == "failed" && @pull_request_analysis.error_message.present? %>
    <p>錯誤（<%= @pull_request_analysis.error_stage %>）：<%= @pull_request_analysis.error_message %></p>
  <% end %>

  <% if @pull_request_analysis.pr_title.present? %>
    <p>標題：<%= @pull_request_analysis.pr_title %></p>
    <p>Base：<%= @pull_request_analysis.base_branch %>　Head：<%= @pull_request_analysis.head_branch %></p>

    <% if @pull_request_analysis.base_branch.present? && @pull_request_analysis.base_branch != @project.default_branch %>
      <p>
        ⚠️ 此 PR 的 Base Branch（<%= @pull_request_analysis.base_branch %>）
        與專案目前母分支（<%= @project.default_branch %>）不同。
        分析將以此 PR 實際的 Base SHA 為準，不會視為相同分支。
      </p>
    <% end %>

    <details>
      <summary>PR 詳細資訊</summary>
      <p>作者：<%= @pull_request_analysis.pr_author %></p>
      <p>描述：<%= simple_format(@pull_request_analysis.pr_description.presence || "（無）") %></p>
      <p>Base SHA：<%= @pull_request_analysis.base_sha %></p>
      <p>Head SHA：<%= @pull_request_analysis.head_sha %></p>
      <p>Merge Base：<%= @pull_request_analysis.merge_base_sha || "（尚未取得）" %></p>
    </details>
  <% end %>

  <p>
    修改檔案：<%= @pull_request_analysis.changed_files.count %>
    受影響技術實體：<%= @pull_request_analysis.impact_items.where.not(code_entity_id: nil).distinct.count(:code_entity_id) %>
    受影響業務功能：<%= @pull_request_analysis.impact_items.where.not(business_feature_id: nil).distinct.count(:business_feature_id) %>
  </p>
</section>

<nav>
  <% Projects::PullRequestAnalysesController::TABS.each do |tab| %>
    <%= link_to tab_label(tab), project_pull_request_analysis_path(@project, @pull_request_analysis, tab: tab),
          class: (@tab == tab ? "active" : nil) %>
  <% end %>
</nav>

<%= render "projects/pull_request_analyses/tabs/#{@tab}" %>
