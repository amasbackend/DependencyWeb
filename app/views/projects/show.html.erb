<h1><%= @project.github_full_name %></h1>

<section>
  <h2>專案資訊</h2>
  <p>Owner: <%= @project.owner %></p>
  <p>母分支: <%= @project.default_branch || "（尚未取得）" %></p>
  <p>Base SHA: <%= @project.base_sha.presence || "（尚未取得）" %></p>
  <p>狀態: <%= @project.status_text %><%= " (#{@project.analysis_status_text})" if @project.status == "importing" || @project.status == "syncing" %></p>
  <p>最後同步: <%= @project.last_synced_at&.strftime("%Y-%m-%d %H:%M") || "尚未同步" %></p>
  <% if @project.status == "failed" && @project.error_message.present? %>
    <p>錯誤: <%= @project.error_message %></p>
  <% end %>
  <%= button_to "同步 GitHub 母資料", sync_project_path(@project), method: :post %>
</section>

<section>
  <h2>搜尋</h2>
  <%= form_with url: project_path(@project), method: :get do %>
    <%= text_field_tag :q, @query, placeholder: "搜尋功能名稱、Controller、Model、檔案路徑..." %>
    <%= hidden_field_tag :view, params[:view] if params[:view].present? %>
    <%= submit_tag "搜尋" %>
  <% end %>

  <% if @query %>
    <h3>搜尋結果：「<%= @query %>」</h3>
    <% if @matched_feature_ids.blank? && @matched_code_entities.blank? %>
      <p>沒有符合的結果。</p>
    <% end %>
    <% if @matched_code_entities.present? %>
      <h4>技術實體</h4>
      <ul>
        <% @matched_code_entities.each do |ce| %>
          <li><%= ce.entity_type_text %>: <%= ce.name %>（<%= ce.file_path %>）</li>
        <% end %>
      </ul>
    <% end %>
  <% end %>
</section>

<section>
  <h2>業務模組</h2>
  <p>
    <%= link_to "業務視圖", project_path(@project, q: @query), class: (params[:view] == "technical" ? nil : "active") %>
    |
    <%= link_to "技術視圖", project_path(@project, view: "technical", q: @query), class: (params[:view] == "technical" ? "active" : nil) %>
  </p>

  <% if @business_modules.empty? %>
    <p>尚未建立業務模組（可能仍在分析中，或母分支沒有可辨識的路由）。</p>
  <% else %>
    <% @business_modules.each do |business_module| %>
      <% features = business_module.business_features.to_a %>
      <% features = features.select { |f| @matched_feature_ids.include?(f.id) } if @query %>
      <% next if @query && features.empty? %>
      <div>
        <strong><%= business_module.name %></strong>
        <ul>
          <% features.each do |feature| %>
            <li>
              <%= feature.name %>
              <% if params[:view] == "technical" %>
                <ul>
                  <% feature.code_entities.each do |code_entity| %>
                    <li><%= code_entity.entity_type_text %>: <%= code_entity.name %>（<%= code_entity.file_path %>）</li>
                  <% end %>
                </ul>
              <% end %>
            </li>
          <% end %>
        </ul>
      </div>
    <% end %>
  <% end %>
</section>

<section>
  <h2>GitHub PR 分析</h2>
  <%= form_with url: project_pull_request_analyses_path(@project), method: :post do %>
    <%= label_tag :pr_number, "PR Number" %>
    <%= number_field_tag :pr_number, nil, placeholder: "65" %>
    <%= submit_tag "分析 PR" %>
  <% end %>
</section>

<section>
  <h2>歷史 PR 分析</h2>
  <% if @project.pull_request_analyses.empty? %>
    <p>尚無分析紀錄。</p>
  <% else %>
    <ul>
      <% @project.pull_request_analyses.order(created_at: :desc).each do |pr_analysis| %>
        <li>
          <%= link_to "PR ##{pr_analysis.pr_number}", project_pull_request_analysis_path(@project, pr_analysis) %>
          — <%= pr_analysis.status_text %>
          <% if pr_analysis.pr_title.present? %> — <%= pr_analysis.pr_title %><% end %>
          — <%= pr_analysis.created_at.strftime("%Y-%m-%d %H:%M") %>
        </li>
      <% end %>
    </ul>
  <% end %>
</section>
